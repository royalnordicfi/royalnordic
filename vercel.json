{
  "version": 2,
  "builds": [
    {
      "src": "api/omega/v1/operational-summary.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "redirects": [
    {
      "source": "/admin-panel",
      "destination": "https://admin.royalnordic.fi/",
      "permanent": true
    },
    {
      "source": "/admin-panel/(.*)",
      "destination": "https://admin.royalnordic.fi/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "https://admin.royalnordic.fi/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "https://admin.royalnordic.fi/",
      "permanent": true
    },
    {
      "source": "/admin-:path*",
      "destination": "https://admin.royalnordic.fi/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.royalnordic.fi" }],
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VITE_SUPABASE_URL": "https://itihdgqgvlphtyidnvkt.supabase.co",
